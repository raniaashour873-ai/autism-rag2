GROQ_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GROQ_MODEL=openai/gpt-oss-20b
RETRIEVAL_DISTANCE_THRESHOLD=0.70
TOP_K_DEFAULT=5
CHUNK_MIN_TOKENS=120
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_TOKENS=80
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION=autism_nice_cg142
RETRIEVAL_LOG_PATH=retrieval_logs.jsonl
GROUNDING_TOKEN_COVERAGE=0.45
USE_HYBRID_RETRIEVAL=true
USE_RERANKER=false
HYBRID_CANDIDATE_COUNT=20
RRF_K=60
RERANK_FINAL_COUNT=3
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_SCORE_THRESHOLD=-2.0
RETRIEVAL_DEBUG=false
CHUNKS_JSON_PATH=step2_chunks.json
EMBEDDING_BACKEND=onnx
ONNX_REPO=Xenova/all-MiniLM-L6-v2
ONNX_FILENAME=onnx/model.onnx
ONNX_TOKENIZER=sentence-transformers/all-MiniLM-L6-v2
ONNX_MAX_LENGTH=256
ONNX_CACHE_DIR=./onnx_cache
# Optional pre-downloaded graph (skips Hub download if the file exists):
ONNX_LOCAL_PATH=
TOKENIZERS_PARALLELISM=false
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
# Browser origin(s) allowed by CORS. Comma-separated. Use * only for local testing.
FRONTEND_URL=*
# Optional Hugging Face token (not required). Helps model downloads on Render.
HF_TOKEN=
# Optional second model for eval_embedding_models.py — leave empty to skip download
EVAL_ALT_EMBEDDING_MODEL=
